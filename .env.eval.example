# Langfuse Local Telemetry & Evaluation Configuration
# Template for local development with docker-compose.langfuse.yml

# ------------------------------------------------------------------------------
# 1. Application Evaluation API Credentials (from Langfuse Project Settings)
# ------------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=pk-lf-local-eval-key
LANGFUSE_SECRET_KEY=sk-lf-local-eval-secret
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_HOST=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Cryptographic Secrets (Generate via provided commands before booting)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=replace-with-64-hex-char-aes-key
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-secure-nextauth-secret-min-32-chars
# Generate with: openssl rand -base64 32
SALT=replace-with-secure-salt-min-32-chars
NEXTAUTH_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. PostgreSQL Database
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-strong-postgres-password
POSTGRES_DB=langfuse

# ------------------------------------------------------------------------------
# 4. ClickHouse Analytics
# ------------------------------------------------------------------------------
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=replace-with-strong-clickhouse-password
CLICKHOUSE_DB=default

# ------------------------------------------------------------------------------
# 5. Redis Cache & Queue
# ------------------------------------------------------------------------------
REDIS_PASSWORD=replace-with-strong-redis-password

# ------------------------------------------------------------------------------
# 6. MinIO Event Storage
# ------------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace-with-strong-minio-password
LANGFUSE_S3_EVENT_UPLOAD_BUCKET=langfuse

