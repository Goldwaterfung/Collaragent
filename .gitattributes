# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Windows shell & script files
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Unix shell scripts
*.sh text eol=lf

# Explicit text files
*.json text
*.yaml text
*.yml text
*.md text
*.ts text
*.tsx text
*.js text
*.jsx text
*.mjs text
*.cjs text
*.css text
*.html text
*.svg text

# Lockfile merge handling
yarn.lock merge=binary -diff
skills-lock.json text

# Binary assets and builds
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.pdf binary
*.zip binary
*.tar.gz binary
*.exe binary
*.dmg binary
*.AppImage binary
*.deb binary
*.node binary
*.wasm binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
