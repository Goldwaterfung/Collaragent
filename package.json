{
  "name": "collaragent",
  "version": "1.0.0",
  "description": "A local-based agent for document management.",
  "main": "./out/main/index.js",
  "author": "Collaragent",
  "homepage": "https://electron-vite.org",
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "NODE_OPTIONS='--max-old-space-size=8192' eslint --cache .",
    "typecheck:node": "NODE_OPTIONS='--max-old-space-size=8192' tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "NODE_OPTIONS='--max-old-space-size=8192' tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "dev:api": "node server/dbServer/documentInstancesApi.js",
    "build": "npm run typecheck && electron-vite build",
    "build:full": "npm run build:backend && npm run build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "electron-vite build && electron-builder --dir",
    "build:win": "electron-vite build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "build:backend": "node scripts/build-backend.mjs"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write"
    ],
    "*.{json,yaml,yml,md,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@atlaskit/drag-and-drop-indicator": "^0.11.1",
    "@atlaskit/pragmatic-drag-and-drop": "^3.0.0",
    "@dagrejs/dagre": "^3.1.1",
    "@earendil-works/pi-ai": "^0.84.4",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@langchain/anthropic": "^1.5.8",
    "@langchain/community": "^1.1.29",
    "@langchain/core": "^1.2.9",
    "@langchain/google": "^0.2.3",
    "@langchain/langgraph": "^1.4.12",
    "@langchain/mcp-adapters": "^1.1.4",
    "@langchain/ollama": "^1.3.0",
    "@langchain/openai": "^1.5.10",
    "@langchain/tavily": "^1.2.0",
    "@lexical/code": "^0.49.0",
    "@lexical/html": "^0.49.0",
    "@lexical/react": "^0.49.0",
    "@lexical/table": "^0.49.0",
    "@mariozechner/pi-agent-core": "^0.73.1",
    "@mariozechner/pi-ai": "^0.73.1",
    "@oozcitak/util": "11.0.0",
    "@tanstack/react-query": "^5.102.0",
    "@types/archiver": "^8.0.0",
    "@types/deno": "^2.7.0",
    "@types/unzipper": "^0.10.11",
    "archiver": "^8.0.0",
    "cors": "^2.8.6",
    "deno": "^2.9.5",
    "dockview-react": "^8.2.0",
    "express": "^5.2.1",
    "fast-glob": "^3.3.3",
    "file-saver": "^2.0.5",
    "fix-path": "^5.0.0",
    "html-to-docx": "^1.8.0",
    "jsondiffpatch": "^0.7.6",
    "katex": "^0.18.4",
    "langchain": "^1.5.10",
    "lexical": "^0.49.0",
    "markdown-it": "^15.0.0",
    "markitdown-ts": "^0.0.10",
    "msgpackr": "^2.0.5",
    "msgpackr-extract": "3.0.4",
    "react-error-boundary": "^6.1.3",
    "textarea-caret": "^3.1.0",
    "unzipper": "^0.12.5",
    "uuid": "^14.0.2",
    "ws": "^8.21.3",
    "yauzl": "^3.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/dagre": "^0.7.54",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^6.1.0",
    "d3-hierarchy": "^3.1.2",
    "dockview": "^8.2.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "node-abi": "^4.35.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vitest": "^4.1.11"
  },
  "resolutions": {
    "node-abi": "^4.35.0"
  }
}
